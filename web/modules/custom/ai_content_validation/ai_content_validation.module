<?php

/**
 * @file
 * Provides an ai validations entity type.
 */

declare(strict_types=1);

use Drupal\ai_content_validation\Hook\FormHooks;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;

/**
 * Prepares variables for ai validations templates.
 *
 * Default template: ai-content-validation-item.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the ai validations
 *     information and any fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_ai_content_validation_item(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'];
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
}

/**
 * Submit handler: accepts one field's pending AI suggestion.
 *
 * Form submit handlers are referenced by name in the cached form array, so
 * these stay procedural and delegate to the hook class.
 */
function ai_content_validation_node_form_apply_submit(array &$form, FormStateInterface $form_state): void {
  \Drupal::classResolver(FormHooks::class)->applySubmit($form, $form_state);
}

/**
 * Submit handler: rejects one field's pending AI suggestion.
 */
function ai_content_validation_node_form_reject_submit(array &$form, FormStateInterface $form_state): void {
  \Drupal::classResolver(FormHooks::class)->rejectSubmit($form, $form_state);
}

/**
 * Submit handler on node Save: writes staged alt-text fixes to media.
 */
function ai_content_validation_node_form_staged_alts_submit(array &$form, FormStateInterface $form_state): void {
  \Drupal::classResolver(FormHooks::class)->applyStagedAlts($form, $form_state);
}

/**
 * Submit handler: runs the improve workflow for one flagged field.
 */
function ai_content_validation_node_form_improve_submit(array &$form, FormStateInterface $form_state): void {
  \Drupal::classResolver(FormHooks::class)->improveSubmit($form, $form_state);
}

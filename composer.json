{
    "name": "drupal/cms",
    "version": "2.0.0-beta2",
    "description": "Drupal CMS is a ready-to-use platform built on Drupal core, offering smart defaults to get started quickly and enterprise-grade tools for marketers, designers, and content creators.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/cms",
    "support": {
        "docs": "https://new.drupal.org/docs/drupal-cms",
        "chat": "https://drupal.org/node/314178"
    },
    "repositories": [
        {
            "name": "drush_dtk",
            "type": "package",
            "package": {
                "name": "ivanboring/drush_dtk",
                "version": "dev-main",
                "type": "drupal-module",
                "source": {
                    "url": "https://github.com/ivanboring/drush_dtk.git",
                    "type": "git",
                    "reference": "main"
                }
            }
        },
        {
            "name": "drupal",
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/composer": "^2.8",
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^2.0",
        "drupal/ai": "^1.5@alpha",
        "drupal/ai_agents": "^1.3",
        "drupal/ai_context": "^1.0@beta",
        "drupal/ai_provider_amazeeio": "1.2.x-dev",
        "drupal/byte": "^1@beta",
        "drupal/byte_theme": "@beta",
        "drupal/config_ignore": "^3.3",
        "drupal/core": "^11.3",
        "drupal/core-composer-scaffold": "^11.3",
        "drupal/core-project-message": "^11.3",
        "drupal/core-recipe-unpack": "^11.3",
        "drupal/core-recommended": "^11.3",
        "drupal/core-vendor-hardening": "^11.3",
        "drupal/cva": "@beta",
        "drupal/drupal_cms_accessibility_tools": "^2",
        "drupal/drupal_cms_ai": "^2",
        "drupal/drupal_cms_forms": "^2",
        "drupal/drupal_cms_google_analytics": "^2",
        "drupal/drupal_cms_seo_tools": "^2",
        "drupal/drupal_cms_starter": "^2",
        "drupal/entity_reference_revisions": "^1.14",
        "drupal/flowdrop": "^2.4",
        "drupal/flowdrop_agents": "^2.0",
        "drupal/flowdrop_ai_context": "^2.0",
        "drupal/flowdrop_ai_provider": "^2.0",
        "drupal/flowdrop_field_widget_actions": "^0.1.0",
        "drupal/flowdrop_gin": "^2.0",
        "drupal/flowdrop_node_session": "1.x-dev",
        "drupal/flowdrop_ui": "1.0.x-dev",
        "drupal/flowdrop_ui_agents": "^2.0",
        "drupal/flowdrop_ui_components": "^2.0@alpha",
        "drupal/gin": "^5.0",
        "drupal/media_library_edit": "^3.0",
        "drupal/mercury": "@beta",
        "drupal/metatag": "^2.2",
        "drupal/recipe_installer_kit": "^1",
        "drupal/webform": "@beta",
        "symfony/css-selector": "^7",
        "symfony/property-access": "^7"
    },
    "require-dev": {
        "behat/mink": "^1.11",
        "drupal/coder": "^9.0",
        "drupal/dtk": "^1.0",
        "drush/drush": "^13.6.1",
        "ivanboring/drush_dtk": "dev-main",
        "mglaman/phpstan-drupal": "^2.0",
        "phpro/grumphp": "^2.0",
        "phpspec/prophecy-phpunit": "^2.2",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^11"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-recipe-unpack": true,
            "drupal/core-vendor-hardening": true,
            "php-http/discovery": true,
            "symfony/runtime": true,
            "phpro/grumphp": true
        },
        "bin-dir": "vendor/bin",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3"
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/example.gitignore": false
            },
            "allowed-packages": [
                "drupal/drupal_cms_seo_tools"
            ]
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "./drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "./recipes/{$name}": [
                "type:drupal-recipe"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                   </>",
                "<bg=blue;fg=white>  Congratulations, you\u2019ve installed Drupal CMS!    </>",
                "<bg=blue;fg=white>                                                   </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://drupal.org/support",
                "  * Get involved with the Drupal community: https://drupal.org/getting-involved"
            ]
        },
        "drupal-core-vendor-hardening": {
            "composer/composer": false
        },
        "patches": {
            "drupal/flowdrop_node_session": {
                "Playground back button links to removed route flowdrop.workflows instead of entity.flowdrop_workflow.collection": "patches/flowdrop-node-session-workflows-route.patch",
                "findEntityContextNodes() misses nodes stored in slim node-identity format (only node_type_id in metadata), so entity context is never injected": "patches/flowdrop-node-session-slim-node-format-entity-context.patch"
            }
        },
        "composer-patches": {
            "ignore-dependency-patches": [
                "drupal/ai_context"
            ]
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php -r \"@unlink('vendor/bin/composer');\""
        ]
    }
}

Fix the node type API route placeholders so the controller arguments resolve.

flowdrop 2.0.0-alpha12 declares {plugin_id} on the nodes.metadata and
nodes.validate_config routes, but NodesController::getNodeMetadata() and
::validateConfiguration() both take $node_type_id. Symfony's argument
resolver cannot fill that, so every call returns a 500 — which breaks the
editor's node config panel: without the parameter schema it never sees the
`format` hints, so custom field widgets (ai_prompt, guardrail_set,
agent_selector) never match and fall back to plain inputs.

diff --git a/modules/flowdrop_node_type/flowdrop_node_type.routing.yml b/modules/flowdrop_node_type/flowdrop_node_type.routing.yml
--- a/modules/flowdrop_node_type/flowdrop_node_type.routing.yml
+++ b/modules/flowdrop_node_type/flowdrop_node_type.routing.yml
@@ -78,7 +78,7 @@
     no_cache: TRUE
 
 flowdrop_node_type.api.nodes.metadata:
-  path: '/api/flowdrop/nodes/{plugin_id}/metadata'
+  path: '/api/flowdrop/nodes/{node_type_id}/metadata'
   defaults:
     _controller: '\Drupal\flowdrop_node_type\Controller\Api\NodesController::getNodeMetadata'
   requirements:
@@ -86,7 +86,7 @@
   methods: [GET]
   options:
     parameters:
-      plugin_id:
+      node_type_id:
         type: string
 
 flowdrop_node_type.api.port_config:
@@ -100,7 +100,7 @@
     no_cache: TRUE
 
 flowdrop_node_type.api.nodes.validate_config:
-  path: '/api/flowdrop/nodes/{plugin_id}/validate'
+  path: '/api/flowdrop/nodes/{node_type_id}/validate'
   defaults:
     _controller: '\Drupal\flowdrop_node_type\Controller\Api\NodesController::validateConfiguration'
   requirements:
@@ -109,5 +109,5 @@
   methods: [POST]
   options:
     parameters:
-      plugin_id:
+      node_type_id:
         type: string
